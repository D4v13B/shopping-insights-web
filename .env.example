# Copiar a .env para desarrollo local:  cp .env.example .env
# En Docker Compose estas variables las define el docker-compose.yml de shopping-insights-api.

# URL de la API desde el navegador (se incrusta en el bundle al construir)
VITE_API_URL=http://localhost:8080
# URL de la API desde el servidor SSR (en Docker: http://api:8080)
API_INTERNAL_URL=http://localhost:8080
# Mismo valor que INTERNAL_API_TOKEN de la API: exime al SSR del rate limit (opcional en local)
INTERNAL_API_TOKEN=
